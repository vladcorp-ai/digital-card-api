generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  links       Link[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model Link {
  id        Int     @id @default(autoincrement())
  profileId Int
  title     String
  url       String
  sortOrder Int     @default(0)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id        Int     @id @default(autoincrement())
  profileId Int
  name      String
  sortOrder Int     @default(0)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

model Experience {
  id           Int           @id @default(autoincrement())
  profileId    Int
  company      String
  position     String
  startDate    DateTime      @db.Date
  endDate      DateTime?     @db.Date
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievements Achievement[]

  @@index([profileId])
}

model Achievement {
  id           Int        @id @default(autoincrement())
  experienceId Int
  text         String
  sortOrder    Int        @default(0)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model Project {
  id          Int     @id @default(autoincrement())
  profileId   Int
  name        String
  url         String
  sortOrder   Int     @default(0)
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
